{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/ai-sdlc-plugin/hooks/enforce-blocked-actions.sh\"",
            "if": "Bash(*)",
            "statusMessage": "Checking action policy..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/ai-sdlc-plugin/hooks/enforce-blocked-actions.sh\"",
            "statusMessage": "Checking write policy..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/ai-sdlc-plugin/hooks/collect-tool-sequence.sh\"",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/ai-sdlc-plugin/hooks/permission-check.sh\"",
            "if": "Bash(gh pr merge*)"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/archive-transcript.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
