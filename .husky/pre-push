#!/usr/bin/env bash
# Husky pre-push hook. Order matters:
#
#   0. Substrate contract integrity gate (AISDLC-453) — RFC-0028 §4 type-registry
#      assertions. Deterministic, no LLM, <5s. Cold-start: no-op when no
#      substrate-contracts/ directory exists (fresh adopter). Skip:
#      AI_SDLC_SKIP_SUBSTRATE_GATE=1.
#   0b. Dark-code gate (AISDLC-687) — `node scripts/check-dark-code.mjs`: a newly
#      unwired module, a grown baseline or a new test double in production code
#      blocks the push. Static scan. Skip: AI_SDLC_SKIP_DARK_CODE_GATE=1.
#      (There is no local coverage gate: coverage is gated once, in CI — AISDLC-726.)
#   2. Squash stacked chore-sign commits (AISDLC-369) — when multiple
#      consecutive "chore: sign attestation" commits accumulate at HEAD
#      (from re-sign cycles), squashes them into one to keep history clean.
#      ORDER: MUST run BEFORE attestation-sign (item 4 below) so the
#      squashed HEAD is the one the attestation is signed against.
#      No-op when there is 0 or 1 chore-sign commit at HEAD.
#   3. Mechanical fixups orchestrator (AISDLC-386) — runs two mechanical
#      fixup sub-hooks in dependency order in a single pass:
#        task-move (AISDLC-220) → attestation-sign (AISDLC-133)
#      (mcp-bundle-sync was DELETED by AISDLC-385 — bundle now distributed via npm)
#      If any fixup ran, exits 1 ONCE with a consolidated "re-run git push"
#      message instead of each sub-hook exiting 1 separately (collapses the
#      worst-case 3-push chain into 2). ORDER IS LOAD-BEARING: task-move
#      MUST run before attestation-sign (attestation's contentHashV4 binds
#      {path, headBlobSha}; if move happens after sign the envelope references
#      the old path → verify-attestation rejects).
#   4-5. Individual sub-hook invocations (task-moved, attestation-sign) remain
#      below as defense-in-depth: on the re-push after the orchestrator exits 1,
#      the orchestrator sees no fixups needed and exits 0. Each sub-hook's
#      idempotency check then confirms clean state. If the orchestrator is
#      bypassed (AI_SDLC_BYPASS_ALL_GATES), the individual hooks below also
#      skip (they check the same bypass var).
#
# Skip individual gates with their respective env vars
# (AI_SDLC_SKIP_SUBSTRATE_GATE=1,
# AI_SDLC_SKIP_TASK_MOVE=1, AI_SDLC_SKIP_SQUASH_CHORES=1,
# AI_SDLC_SKIP_CHANGELOG_CHECK=1, AI_SDLC_SKIP_FOLLOWUP_GATE=1,
# AI_SDLC_SKIP_ATTESTATION_SIGN=1, AI_SDLC_SKIP_DARK_CODE_GATE=1)
# or skip all pre-push hooks via `git push --no-verify` (use sparingly —
# these gates exist because the things they guard have failed silently in
# the past).

set -eu
# `pipefail` is a bash/ksh/zsh option; POSIX sh (dash, Ubuntu's /bin/sh) LACKS
# it and hard-errors on `set -o pipefail` ("Illegal option -o pipefail"). Husky
# v9 SOURCES this hook under `sh` — ignoring the `#!/usr/bin/env bash` shebang —
# so on Linux CI the shell is dash and a bare `set -euo pipefail` aborts the hook
# before any gate runs, failing the push. macOS /bin/sh is bash so it only ever
# broke on Linux (the CI-based gh-issue pipeline). Enable pipefail only when the
# running shell actually supports it. (GitHub issue #1037.)
if (set -o pipefail) 2>/dev/null; then
  set -o pipefail
fi

# Read git's pre-push stdin once so multiple gates can consume the range info.
# (AISDLC-370: DoR gate uses the push range to walk touched task files.)
PUSH_STDIN="$(cat || true)"

node scripts/check-substrate-contract.mjs
# AISDLC-687: dark-code static scan (cheap). Skip:
# AI_SDLC_SKIP_DARK_CODE_GATE=1.
./scripts/check-dark-code-on-push.sh
if [ "${AI_SDLC_SKIP_SQUASH_CHORES:-}" != "1" ]; then
  ./scripts/squash-attestation-chores.sh
fi
# AISDLC-401: warn when CHANGELOG.md is staged on a feature branch.
# release-please owns CHANGELOG.md; manual edits cause rebase conflicts.
printf '%s\n' "$PUSH_STDIN" | ./scripts/check-changelog-edit.sh
# Follow-up gate: completed task files added/modified in the push range must
# track, decline, or say "(none)" for every follow-up. Runs before the fixup
# orchestrator. Skip: AI_SDLC_SKIP_FOLLOWUP_GATE=1
printf '%s\n' "$PUSH_STDIN" | ./scripts/check-followups-on-push.sh
# AISDLC-386: orchestrator handles all mechanical fixups (task-move →
# attestation-sign) in a single pass and exits 1 ONCE if any work was done.
# (mcp-bundle-sync removed per AISDLC-385 — bundle now distributed via npm.)
# This collapses the worst-case 3-push chain into 2.
# The individual hook invocations below act as defense-in-depth: on the
# re-push after the orchestrator exits 1, the orchestrator sees no fixups
# needed and exits 0, then each sub-hook's own idempotency check confirms
# the state is clean. If the orchestrator is bypassed (AI_SDLC_BYPASS_ALL_GATES)
# the individual hooks below also skip (they check the same bypass var).
printf '%s\n' "$PUSH_STDIN" | ./scripts/pre-push-fixups.sh
./scripts/check-task-moved.sh
./scripts/check-attestation-sign.sh
