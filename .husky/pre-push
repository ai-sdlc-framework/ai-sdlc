#!/usr/bin/env bash
# Husky pre-push hook. Order matters:
#
#   0. Substrate contract integrity gate (AISDLC-453) — RFC-0028 §4 type-registry
#      assertions. Deterministic, no LLM, <5s. Cold-start: no-op when no
#      substrate-contracts/ directory exists (fresh adopter). Skip:
#      AI_SDLC_SKIP_SUBSTRATE_GATE=1.
#   0b. Dark-code gate (AISDLC-687) — `node scripts/check-dark-code.mjs`: a newly
#      unwired module, a grown baseline or a new test double in production code
#      blocks the push. Static scan. Skip: AI_SDLC_SKIP_DARK_CODE_GATE=1.
#      (There is no local coverage gate: coverage is gated once, in CI — AISDLC-726.)
#   2. Mechanical fixups orchestrator (AISDLC-386, AISDLC-837) — ONE call of
#      scripts/pre-push-fixups.sh runs, in order:
#        squash-attestation-chores (AISDLC-369) → task-move (AISDLC-220)
#        → attestation-sign (AISDLC-133)
#      ORDER IS LOAD-BEARING: squash first so the squashed HEAD is the one
#      signed; task-move before sign (contentHashV4 binds {path, headBlobSha}).
#      If task-move or sign made a commit, exits 1 ONCE ("re-run git push");
#      the re-push finds nothing to do and exits 0. The sub-hooks are no
#      longer invoked directly from this file.
#
# Skip individual gates with their respective env vars
# (AI_SDLC_SKIP_SUBSTRATE_GATE=1,
# AI_SDLC_SKIP_TASK_MOVE=1, AI_SDLC_SKIP_SQUASH_CHORES=1,
# AI_SDLC_SKIP_FOLLOWUP_GATE=1,
# AI_SDLC_SKIP_ATTESTATION_SIGN=1, AI_SDLC_SKIP_DARK_CODE_GATE=1,
# AI_SDLC_SKIP_MARKER_GATE=1)
# or skip all pre-push hooks via `git push --no-verify` (use sparingly —
# these gates exist because the things they guard have failed silently in
# the past).

set -eu
# `pipefail` is a bash/ksh/zsh option; POSIX sh (dash, Ubuntu's /bin/sh) LACKS
# it and hard-errors on `set -o pipefail` ("Illegal option -o pipefail"). Husky
# v9 SOURCES this hook under `sh` — ignoring the `#!/usr/bin/env bash` shebang —
# so on Linux CI the shell is dash and a bare `set -euo pipefail` aborts the hook
# before any gate runs, failing the push. macOS /bin/sh is bash so it only ever
# broke on Linux (the CI-based gh-issue pipeline). Enable pipefail only when the
# running shell actually supports it. (GitHub issue #1037.)
if (set -o pipefail) 2>/dev/null; then
  set -o pipefail
fi

# Read git's pre-push stdin once so multiple gates can consume the range info.
# (AISDLC-370: DoR gate uses the push range to walk touched task files.)
PUSH_STDIN="$(cat || true)"

node scripts/check-substrate-contract.mjs
# AISDLC-727: CI-skip magic-token gate (AISDLC-88). Was documented as enforced but never
# called from any hook; it is a fast per-commit text scan of the push range, so it runs
# first. Skip: AI_SDLC_SKIP_MARKER_GATE=1.
printf '%s\n' "$PUSH_STDIN" | ./scripts/check-skip-ci-marker.sh
# AISDLC-687: dark-code static scan (cheap). Skip:
# AI_SDLC_SKIP_DARK_CODE_GATE=1.
./scripts/check-dark-code-on-push.sh
# AISDLC-838: whole-workspace typecheck runs once, here, not on every commit.
node scripts/typecheck-workspace.mjs
# AISDLC-773: protected knowledge stays out of the tracked root, and out of the PR body
# when the pusher supplies it via AI_SDLC_PR_BODY_FILE (RFC-0053 OQ-1).
printf '%s\n' "$PUSH_STDIN" | ./scripts/check-knowledge-scope.sh --push-stdin
if [ -n "${AI_SDLC_PR_BODY_FILE:-}" ] && [ -f "$AI_SDLC_PR_BODY_FILE" ]; then
  ./scripts/check-pr-body-protected.sh "$AI_SDLC_PR_BODY_FILE"
fi
# Follow-up gate: completed task files added/modified in the push range must
# track, decline, or say "(none)" for every follow-up. Runs before the fixup
# orchestrator. Skip: AI_SDLC_SKIP_FOLLOWUP_GATE=1
printf '%s\n' "$PUSH_STDIN" | ./scripts/check-followups-on-push.sh
# AISDLC-386/837: the orchestrator handles squash, task-move and attestation-sign
# in a single pass and exits 1 ONCE if a fixup commit was made. Skips:
# AI_SDLC_SKIP_SQUASH_CHORES, AI_SDLC_SKIP_TASK_MOVE, AI_SDLC_SKIP_ATTESTATION_SIGN.
printf '%s\n' "$PUSH_STDIN" | ./scripts/pre-push-fixups.sh
