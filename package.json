{
  "name": "ai-sdlc",
  "private": true,
  "version": "0.1.0",
  "description": "AI-SDLC Framework — open, vendor-neutral governance for AI-augmented software development lifecycles",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:gates && pnpm rfc:check && pnpm dark-code:check && pnpm lint:publishable && pnpm knowledge:check && pnpm sync:plugin-runtime-deps:check",
    "test:gates": "node scripts/run-gate-tests.mjs",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "eslint . && node scripts/check-clock-discipline.mjs",
    "lint:fix": "eslint . --fix",
    "lint:publishable": "node scripts/check-publishable-package-configs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean",
    "tui": "AI_SDLC_TUI=experimental node pipeline-cli/bin/cli-tui.mjs",
    "validate-schemas": "pnpm -C reference validate-schemas",
    "smoke:first-run": "node scripts/first-run-smoke.mjs",
    "test:first-run-smoke-gate": "node --test scripts/first-run-smoke.test.mjs",
    "test:first-run-smoke-workflow": "node --test .github/workflows/__tests__/first-run-smoke.test.mjs",
    "test:ci-gate-hygiene": "node --test .github/workflows/__tests__/no-json-capture.test.mjs .github/workflows/__tests__/main-health-gate-scripts.test.mjs",
    "test:backlog-drift-report-file": "node --test .github/workflows/__tests__/backlog-drift-report-file.test.mjs",
    "test:knowledge-scope-gate": "node --test scripts/check-knowledge-scope.test.mjs",
    "knowledge:check": "bash scripts/check-knowledge-scope.sh",
    "test:dark-code-push-gate": "node --test scripts/check-dark-code-on-push.test.mjs",
    "test:typecheck-workspace-gate": "node --test scripts/typecheck-workspace.test.mjs",
    "test:publishable": "node --test scripts/check-publishable-package-configs.test.mjs",
    "dark-code:check": "node scripts/check-dark-code.mjs",
    "test:clock-discipline-gate": "node --test scripts/check-clock-discipline.test.mjs",
    "test:dark-code-gate": "node --test scripts/check-dark-code.test.mjs",
    "test:task-move-gate": "node --test scripts/check-task-moved.test.mjs",
    "test:attestation-sign-gate": "node --test scripts/check-attestation-sign.test.mjs",
    "test:plugin-suite-gate": "cd ai-sdlc-plugin && node --test hooks/*.test.mjs agents/*.test.mjs scripts/*.test.mjs commands/*.test.mjs",
    "test:plugin-commands-gate": "node --test \"ai-sdlc-plugin/commands/*.test.mjs\"",
    "test:plugin-model-pins-gate": "node --test ai-sdlc-plugin/commands/model-pins.test.mjs",
    "test:plugin-attestation-sign-gate": "node --test ai-sdlc-plugin/scripts/check-attestation-sign.test.mjs",
    "test:sign-attestation-if-consumer-gate": "node --test ai-sdlc-plugin/scripts/sign-attestation-if-consumer.test.mjs",
    "test:transcript-attribution-gate": "node --test scripts/resolve-transcript-task-id.test.mjs",
    "test:reviewer-script-bundle-parity-gate": "node --test scripts/check-reviewer-script-bundle-parity.test.mjs",
    "test:adopter-reviewer-attribution-smoke-gate": "node --test scripts/adopter-reviewer-attribution-smoke.test.mjs",
    "test:sign-attestation-gate": "node --test ai-sdlc-plugin/scripts/sign-attestation.test.mjs",
    "test:persist-reviewer-artifacts-gate": "node --test ai-sdlc-plugin/scripts/persist-reviewer-artifacts.test.mjs",
    "test:install-runtime-deps-gate": "node --test ai-sdlc-plugin/scripts/install-runtime-deps.test.mjs",
    "test:check-stale-runtime-deps-gate": "node --test ai-sdlc-plugin/scripts/check-stale-runtime-deps.test.mjs",
    "test:context-warn-gate": "node --test ai-sdlc-plugin/hooks/context-warn.test.mjs ai-sdlc-plugin/hooks/session-start-clear.test.mjs",
    "test:usage-ingest-hook-gate": "node --test ai-sdlc-plugin/hooks/usage-ingest.test.mjs",
    "test:context-budget-hook-gate": "node --test ai-sdlc-plugin/hooks/context-budget.test.mjs",
    "test:governance-resolver-gate": "node --test ai-sdlc-plugin/hooks/lib/governance-resolver.test.mjs ai-sdlc-plugin/hooks/lib/governance-lease.test.mjs ai-sdlc-plugin/hooks/lib/trusted-policy.test.mjs ai-sdlc-plugin/hooks/lib/lease-push-guard.test.mjs ai-sdlc-plugin/hooks/enforce-lease-push.test.mjs ai-sdlc-plugin/hooks/lease-push-docs.test.mjs ai-sdlc-plugin/hooks/session-start.test.mjs ai-sdlc-plugin/hooks/subagent-start.test.mjs ai-sdlc-plugin/hooks/enforce-blocked-actions.test.mjs ai-sdlc-plugin/hooks/permission-check.test.mjs ai-sdlc-plugin/hooks/lib/merge-matcher.test.mjs ai-sdlc-plugin/scripts/render-governance-hard-rules.test.mjs ai-sdlc-plugin/hooks/lib/hierarchy-role.test.mjs ai-sdlc-plugin/hooks/lib/role-tool-policy.test.mjs ai-sdlc-plugin/hooks/enforce-role-tools.test.mjs ai-sdlc-plugin/scripts/render-role-tool-rules.test.mjs ai-sdlc-plugin/hooks/governance-happy-path.test.mjs ai-sdlc-plugin/hooks/governance-refusal-messages.test.mjs",
    "test:verify-attestation-gate": "node --test scripts/verify-attestation.test.mjs",
    "test:verify-attestation-plugin-gate": "node --test ai-sdlc-plugin/scripts/verify-attestation.test.mjs",
    "test:orchestrator-state-gate": "node --test scripts/check-orchestrator-state.test.mjs ai-sdlc-plugin/scripts/check-orchestrator-state.parity.test.mjs",
    "test:prepush-dash-safe": "node --test scripts/check-prepush-dash-safe.test.mjs",
    "test:gate-workflow": "node --test .github/workflows/__tests__/ai-sdlc-gate.test.mjs",
    "test:review-workflow": "node --test .github/workflows/__tests__/ai-sdlc-review.test.mjs",
    "test:fork-pr-safety": "node --test .github/workflows/__tests__/fork-pr-safety.test.mjs",
    "test:consumer-verify-attestation-workflow": "node --test .github/workflows/__tests__/consumer-verify-attestation.test.mjs",
    "test:verify-attestation-workflow": "node --test .github/workflows/__tests__/verify-attestation.test.mjs && node --test .github/workflows/__tests__/verify-attestation-cancelled.test.mjs",
    "test:dor-ingress-workflow": "node --test .github/workflows/__tests__/dor-ingress.test.mjs",
    "test:post-attestation-review": "node --test scripts/post-attestation-review.test.mjs",
    "test:docs-only-classifier": "node --test scripts/is-docs-only-changeset.test.mjs",
    "test:audit-gate": "node --test scripts/audit-with-ignores.test.mjs",
    "test:drop-stale-envelope": "node --test scripts/drop-stale-attestation-envelope.test.mjs",
    "test:auto-rebase-stale-prs": "node --test scripts/auto-rebase-stale-prs.test.mjs",
    "test:followup-gate": "node --test scripts/check-followups.test.mjs",
    "test:pre-push-fixups-gate": "node --test scripts/pre-push-fixups.test.mjs",
    "test:adopter-facing-strings": "node --test scripts/check-adopter-facing-strings.test.mjs",
    "test:patch-coverage-gate": "node --test scripts/check-pr-patch-coverage.test.mjs",
    "test:pr-coverage-gate": "node --test scripts/pr-coverage.test.mjs",
    "test:release-please-config": "node --test .github/workflows/__tests__/release-please-config.test.mjs .github/workflows/__tests__/release-yml-pin-sync.test.mjs",
    "test:require-issue-link": "node --test .github/workflows/__tests__/require-issue-link.test.mjs scripts/issue-link-decision.test.mjs",
    "test:sdk-go-schema-mirror": "node --test scripts/check-sdk-go-agent-role-schema.test.mjs",
    "test:single-pr-ci-run": "node --test .github/workflows/__tests__/single-pr-ci-run.test.mjs",
    "test:load-discipline-workflow": "node --test .github/workflows/__tests__/load-discipline.test.mjs",
    "test:supply-chain-hardening": "node --test .github/workflows/__tests__/action-pinning.test.mjs .github/workflows/__tests__/no-new-pr-gate.test.mjs",
    "test:trust-marker-workflow": "node --test .github/workflows/__tests__/trust-marker.test.mjs scripts/check-governance-boundary.test.mjs",
    "test:untrusted-pr-gate-workflow": "node --test .github/workflows/__tests__/untrusted-pr-gate.test.mjs",
    "test:substrate-contract-gate": "node --test scripts/check-substrate-contract.test.mjs",
    "test:substrate-contract-conformance": "node --test scripts/check-substrate-contract.conformance.test.mjs",
    "sync:plugin-runtime-deps:check": "node scripts/sync-plugin-runtime-deps.mjs --check",
    "test:sync-plugin-runtime-deps-gate": "node --test scripts/sync-plugin-runtime-deps.test.mjs",
    "test:pr-governance-gate": "node --test scripts/check-pr-governance.test.mjs",
    "test:parent-on-main-hook": "node --test ai-sdlc-plugin/hooks/parent-on-main.test.mjs",
    "rfc:check": "node scripts/check-rfc-docs.mjs",
    "rfc:test": "node --test scripts/check-rfc-docs.test.mjs && node --test scripts/check-rfc-lifecycle-transitions.test.mjs",
    "rfc:lifecycle-check": "node scripts/check-rfc-lifecycle-transitions.mjs",
    "supervisor:start": "node pipeline-cli/bin/cli-dispatch-supervisor.mjs start",
    "supervisor:status": "node pipeline-cli/bin/cli-dispatch-supervisor.mjs status",
    "supervisor:stop": "node pipeline-cli/bin/cli-dispatch-supervisor.mjs stop",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ],
    "*.py": [
      "ruff format",
      "ruff check --fix"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "postcss@<8.5.23": ">=8.5.23",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "fast-uri@>=3.0.0 <3.1.8": ">=3.1.8",
      "nanoid@<3.3.18": ">=3.3.18",
      "source-map-js@<1.2.2": ">=1.2.2"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "js-yaml": "5.4.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
